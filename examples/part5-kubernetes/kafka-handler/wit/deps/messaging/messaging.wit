// Vendored verbatim from the upstream wasmCloud/messaging WIT package
// (https://github.com/wasmCloud/messaging, wit/messaging.wit @ 0.2.0 — the
// STABLE sync revision; a newer 0.3.0 async revision exists upstream but
// 0.2.0 is what the `messaging-kafka` provider and wasmcloud host 1.9.1 speak,
// matching Part 4/5's http-server:0.27.0 pairing convention). cargo-component
// does not fetch WIT packages over the network, so every non-contract package
// a local world references must be present on disk — exactly the wasi:http
// vendoring under part3-interfaces/http-rust/wit/deps. This file is NOT
// edited; it is the upstream package byte-for-byte.
package wasmcloud:messaging@0.2.0;

// Types common to message broker interactions
interface types {
    // A message sent to or received from a broker
    record broker-message {
        subject: string,
        body: list<u8>,
        reply-to: option<string>,
    }
}

interface handler {
    use types.{broker-message};

    // Callback handled to invoke a function when a message is received from a subscription
    handle-message: func(msg: broker-message) -> result<_, string>;
}

interface consumer {
    use types.{broker-message};

    // Perform a request operation on a subject
    request: func(subject: string, body: list<u8>, timeout-ms: u32) -> result<broker-message, string>;
    // Publish a message to a subject without awaiting a response
    publish: func(msg: broker-message) -> result<_, string>;
}
