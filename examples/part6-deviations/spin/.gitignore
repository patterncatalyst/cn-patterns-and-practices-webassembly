# Rust build tree — also covered by the repo-root .gitignore, named here
# explicitly to match this book's per-crate convention.
target/

# The composed artifact build.sh produces (wac plug: provider + handler). Same
# never-commit convention as ../../part5-kubernetes/kafka-host/kafka-app.wasm;
# Cargo.lock IS committed for reproducible builds.
cargo-spin.wasm

# Regenerated by build.sh on every run — never hand-edited, never committed.
spin-build.toml
spin-dependencies.wit

# `spin up` runtime state (component stdio logs, sqlite/kv defaults).
.spin/
