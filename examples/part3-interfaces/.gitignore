# Build artifacts — regenerated by verify.sh / build.sh / cargo.
# Cargo.lock IS committed for the native/binary crates (host, bridge) and the
# cargo-component crates so prost/tonic/wasmtime versions are reproducible.
*/target/
**/target/

# TinyGo component build outputs and intermediates.
http-go/core.wasm
http-go/embedded.wasm
http-go/cargo-http-go.wasm
proto-go/core.wasm
proto-go/embedded.wasm
proto-go/cargo-proto-go.wasm
sockets-go/core.wasm
sockets-go/embedded.wasm
sockets-go/sockets-client-go.wasm

# Composed components are non-deterministic (wac#216) and written to a temp dir
# by verify.sh, never committed.
composed*.wasm
