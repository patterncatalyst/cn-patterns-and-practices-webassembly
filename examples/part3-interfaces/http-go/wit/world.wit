package patterncatalyst:cargo-http-go@0.1.0;

/// TinyGo HTTP front door for the cargo domain (ch11, GATE B attempt).
///
/// Same shape as http-rust: INCLUDE `wasi:http/proxy` (export
/// `wasi:http/incoming-handler`) and IMPORT the three cargo interfaces. The
/// cargo package is a read-only copy under wit/deps/cargo because wit-bindgen-go
/// resolves a WIT directory tree and has no path-dependency mechanism; the
/// repository contract itself stays untouched.
world cargo-http-go {
    include wasi:http/proxy@0.2.8;

    import patterncatalyst:cargo/types@0.1.0;
    import patterncatalyst:cargo/booking@0.1.0;
    import patterncatalyst:cargo/handling@0.1.0;
}
