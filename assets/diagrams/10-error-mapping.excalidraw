   "updated": 1,
   "link": null,
   "locked": false,
   "text": "host/src/main.rs observes the left/right paths identically: Ok(Err(cargo-error::...)) for a result, an Err from the CALL itself for a trap; regardless of which language produced it.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "host/src/main.rs observes the left/right paths identically: Ok(Err(cargo-error::...)) for a result, an Err from the CALL itself for a trap; regardless of which language produced it.",
   "lineHeight": 1.25,
   "baseline": 12
  },
