   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Contrast with a container: it starts with the host's network stack by default and loses it only by subtraction (namespaces, egress policy).",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Contrast with a container: it starts with the host's network stack by default and loses it only by subtraction (namespaces, egress policy).",
   "lineHeight": 1.25,
   "baseline": 12
  },
