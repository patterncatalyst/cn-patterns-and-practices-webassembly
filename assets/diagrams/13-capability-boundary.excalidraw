   "versionNonce": 1893450619,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A component starts with none and gains exactly what -S inherit-network hands it: no grant, no socket, no exception.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A component starts with none and gains exactly what -S inherit-network hands it: no grant, no socket, no exception.",
