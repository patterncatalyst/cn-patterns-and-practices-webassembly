   "versionNonce": 483221362,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Contrast with Chapter 2: a container starts with the host's network stack by default and loses it only by subtraction (namespaces, egress policy).",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Contrast with Chapter 2: a container starts with the host's network stack by default and loses it only by subtraction (namespaces, egress policy).",
   "lineHeight": 1.25,
   "baseline": 12
  },
  {
   "id": "t661166178",
   "type": "text",
   "x": 590,
   "y": 610,
   "width": 759.0000000000001,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
