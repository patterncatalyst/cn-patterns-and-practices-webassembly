   "link": null,
   "locked": false,
   "text": "One `wash up -d` starts NATS + wadm + the host; `wash app deploy wadm.yaml` starts the provider + component and establishes the link.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "One `wash up -d` starts NATS + wadm + the host; `wash app deploy wadm.yaml` starts the provider + component and establishes the link.",
   "lineHeight": 1.25,
   "baseline": 12
  },
  {
   "id": "t1513824829",
   "type": "text",
   "x": 590,
   "y": 638,
   "width": 640.2,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1985541159,
   "versionNonce": 899033014,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The provider owns the socket; the component only ever sees a WIT call \u2014 it never parses raw HTTP.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The provider owns the socket; the component only ever sees a WIT call \u2014 it never parses raw HTTP.",
   "lineHeight": 1.25,
   "baseline": 12
  }
 ],
