   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "containerd-shim-spin needs a privileged node install; restricted-v2 does not allow it, so CRC runs the Spin CLI in an ordinary container instead.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "containerd-shim-spin needs a privileged node install; restricted-v2 does not allow it, so CRC runs the Spin CLI in an ordinary container instead.",
   "lineHeight": 1.25,
   "baseline": 11
